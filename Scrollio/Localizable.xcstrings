      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling, buttons, gestures and the Shortcut Ring are off until then."
          }
        }
      }
    },
    "gesture-freeze-pointer-mouse-holds": {
      "comment": "Gestures pane and an app's Gestures part: under \"Freeze pointer during a gesture\" while the switch reads on and is dimmed, because the mouse tracks every button that runs the gestures; the quoted name is the switch of the Logitech mouse box (mouse-gesture-device-tracking)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mouse holds the pointer still while “Let the mouse track the gesture” is on."
          }
        }
      }
    },
    "gesture-freeze-pointer-mouse-holds-some": {
      "comment": "Gestures pane and an app's Gestures part: under \"Freeze pointer during a gesture\" while the mouse tracks some of the buttons that run the gestures and not others; the switch then decides for the others only",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For buttons the mouse does not track. It holds the pointer still for the ones it tracks."
          }
        }
      }
    },
    "buttons-default-good-for-both": {
      "comment": "Buttons pane: under the Gesture button or the Thumb panel of the connected mouse while it has no action and no button runs Gesture Navigation or opens the Shortcut Ring yet; Gestures and Shortcut Ring are named as in the sidebar",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for Gestures or the Shortcut Ring."
          }
        }
      }
    },
    "buttons-default-good-for-gestures": {
      "comment": "Buttons pane: the same line while something already opens the Shortcut Ring and no button runs Gesture Navigation yet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for Gestures."
          }
        }
      }
    },
    "buttons-default-good-for-ring": {
      "comment": "Buttons pane: the same line while a button already runs Gesture Navigation and nothing opens the Shortcut Ring yet",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for the Shortcut Ring."
          }
        }
      }
    },
    "apps-different-in": {
      "comment": "Scrolling, Buttons, Gestures and Shortcut Ring: the pane's last line, the apps that have settings of that kind of their own; %@ the list of app names joined by ListFormatter, each name a link (“Different in Safari and Figma”, “Different in Safari, Figma and 3 more”). No full stop",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different in %@"
          }
        }
      }
    },
    "apps-different-more": {
      "comment": "That line's last item when four or more apps differ: the apps that are not named, a link to Apps; %d is 2 or more (“3 more”)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d more"
          }
        }
      }
    },
    "apps-different-show-apps": {
      "comment": "Tooltip and VoiceOver label of “3 more” in that line: it shows the Apps list",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Apps"
          }
        }
      }
    },
