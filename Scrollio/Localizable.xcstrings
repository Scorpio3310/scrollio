    },
    "ring-menu-place-left": {
      "comment": "Shortcut Ring pane, the Swap With submenu: a place of the ring in Title Case, as menus name things (the rows say \"Left\")",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left"
          }
        }
      }
    },
    "ring-menu-place-top-left": {
      "comment": "Shortcut Ring pane, the Swap With submenu: a place of the ring in Title Case, as menus name things (the rows say \"Top left\")",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top Left"
          }
        }
      }
    },
    "ring-trigger-named": {
      "comment": "Shortcut Ring pane, the line of the first row while it names what opens the ring and a key combination is among it (so the line does not add that one works too): %@ is the buttons and keys joined as a list, or \"Only in Figma: ⌃⌥ Space\"",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@."
          }
        }
      }
    },
    "buttons-recorder-in-list": {
      "comment": "Key recorder popover of \"+\" in Buttons and in an app's Buttons: the pressed button or key is listed already and its row has no action (\"Default\"), so \"Already has an action\" would not be true",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already in the list"
          }
        }
      }
    },
    "buttons-recorder-own-button": {
      "comment": "Key recorder popover of a row's \"Keyboard Shortcut…\": the row's own button was pressed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A button cannot send itself"
          }
        }
      }
    },
    "buttons-recorder-own-key": {
      "comment": "Key recorder popover of a row's \"Keyboard Shortcut…\": the row's own key was pressed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key cannot send itself"
          }
        }
      }
    },
    "buttons-undo-add": {
      "comment": "Buttons pane and an app's Buttons part: the Undo menu item reads \"Undo Add Button\" after \"+\" added a row",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Button"
          }
        }
      }
    },
    "apps-buttons-undo-add-thumb-wheel": {
      "comment": "An app's Buttons part: the Undo menu item reads \"Undo Add Thumb Wheel\" after \"+\" gave the app the thumb wheel",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Thumb Wheel"
          }
        }
      }
    },
    "key-recorder-needs-access-hint": {
      "comment": "Key recorder popover that opens instead of a recording while Scrollio has no Accessibility access: the small line under \"Scrollio needs Accessibility access\"; General is the Settings pane",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow it under General."
          }
        }
      }
    },
    "key-recorder-could-not-start": {
      "comment": "Key recorder popover that opens instead of a recording that could not start although Scrollio has Accessibility access",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording couldn't start"
          }
        }
      }
    },
    "key-recorder-try-again": {
      "comment": "Key recorder popover: the small line under \"Recording couldn't start\"",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again in a moment."
          }
        }
      }
    },
    "key-recorder-paused": {
      "comment": "Key recorder popover, the small line while Scrollio is paused: the buttons only Scrollio reads from a Logitech mouse (gesture button, thumb panel) do not arrive",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollio is paused:\nsome Logitech buttons cannot be recorded now"
          }
        }
      }
    },
    "status-menu-title-cannot-post-events": {
      "comment": "Status bar menu: the title while Scrollio runs but macOS does not let it post events (the Post Event right): scrolling is not smoothed, and shortcuts from buttons, gestures and the Shortcut Ring may not reach apps",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollio can't send events to apps"
          }
        }
      }
    },
    "status-item-cannot-post-events": {
      "comment": "Menu bar icon tooltip: the same as status-menu-title-cannot-post-events",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollio can't send events to apps."
          }
        }
      }
    },
    "status-menu-open-accessibility-settings": {
      "comment": "Status bar menu: the item under \"Scrollio can't send events to apps\"; opens System Settings › Privacy & Security › Accessibility; its tooltip is general-cannot-post-events-hint",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Accessibility Settings…"
          }
        }
      }
    },
    "general-cannot-post-events-hint": {
      "comment": "General pane: under \"Scrollio can't send events to apps\" in the row under the card (three lines beside Pause); also the tooltip of the status bar menu's \"Open Accessibility Settings…\". Pause first: removing Scrollio from the list while its event taps run can stop the mouse and keyboard",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling isn't smoothed, and buttons, gestures and the Shortcut Ring may not work. Pause Scrollio, then in Privacy & Security › Accessibility remove it with − and add it again. This usually brings it back."
          }
        }
      }
    },
    "intro-access-cannot-post-events-title": {
      "comment": "Welcome Guide, Accessibility step: the status box's title while access is allowed and Scrollio runs, but macOS does not let it post events (the line under it is general-cannot-post-events-hint)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed, but Scrollio can't send events to apps"
          }
        }
      }
    },
    "intro-feel-cannot-post-events": {
      "comment": "Welcome Guide, feel step: the line over the sample page while macOS does not let Scrollio post events, so the page is not smoothed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not smoothed: Scrollio can't send events"
          }
        }
      }
    },
    "status-menu-title-no-display-frames": {
      "comment": "Status bar menu: the title while Scrollio runs but the display links it times smooth scrolling with send no frames (three new ones in a row sent none); the wheel scrolls unsmoothed. Also General's title for it",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth scrolling is off: no display frames"
          }
        }
      }
    },
    "status-item-no-display-frames": {
      "comment": "Menu bar icon tooltip: the same as status-menu-title-no-display-frames",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth scrolling is off: no display frames."
          }
        }
      }
    },
    "general-no-display-frames-hint": {
      "comment": "General pane: under \"Smooth scrolling is off: no display frames\" in the row under the card; what happens and the way out",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wheel scrolls without smoothing. Quit and reopen Scrollio."
          }
        }
      }
    },
    "intro-access-no-display-frames-title": {
      "comment": "Welcome Guide, Accessibility step: the status box's title while access is allowed and Scrollio runs, but its display links send no frames (the line under it is general-no-display-frames-hint)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed, but smooth scrolling is off: no display frames"
          }
        }
      }
    },
    "intro-feel-no-display-frames": {
      "comment": "Welcome Guide, feel step: the line over the sample page while Scrollio's display links send no frames, so the page is not smoothed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not smoothed: no display frames"
          }
        }
      }
    },
    "gesture-follow-actions-label": {
      "comment": "Gestures pane and an app's Gestures part: the switch under \"Mode\" that makes the Up and Down directions open Mission Control and Show Desktop with the hand, as the desktops follow it sideways",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up and Down follow the hand too (Experimental)"
          }
        }
      }
    },
    "gesture-follow-actions-hint-one": {
      "comment": "Gestures pane: under \"Up and Down follow the hand too\" in \"Follow the hand\", while one action can open with the hand on this Mac; %@ is its name (\"Mission Control\")",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opens with your hand, like on a trackpad. Other actions run once."
          }
        }
      }
    },
    "gesture-follow-actions-hint-several": {
      "comment": "Gestures pane: under \"Up and Down follow the hand too\" in \"Follow the hand\", while several actions can open with the hand on this Mac; %@ is the list of their names (\"Mission Control and Show Desktop\")",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ open with your hand, like on a trackpad. Other actions run once."
          }
        }
      }
    },
    "gesture-follow-actions-hint-none": {
      "comment": "Gestures pane: under \"Up and Down follow the hand too\" in \"Follow the hand\", while no action can open with the hand on this Mac (the trackpad gestures are off in System Settings, or macOS lets Scrollio post no events)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing can open with your hand on this Mac right now."
          }
        }
      }
    },
    "gesture-follow-actions-hint-discrete": {
      "comment": "Gestures pane: under \"Up and Down follow the hand too\" while the mode is \"One action per hold\"; the switch is dimmed",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used in “Follow the hand”."
          }
        }
      }
    },
    "gesture-follow-action-value": {
      "comment": "Gestures pane: what the pull-down of Up or Down shows in place of its action while that action opens with the hand; %@ is the action's name (\"Mission Control\", \"Show Desktop\", \"Launchpad\")",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ follows the hand"
          }
        }
      }
    },
    "gesture-follow-apps-value": {
      "comment": "Gestures pane: what the pull-down of Up or Down shows in place of the action \"Apps\" (macOS 26 and later) while it opens with the hand; \"Apps\" is a plural",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps follow the hand"
          }
        }
      }
    },
    "gesture-follow-once-macos": {
      "comment": "Gestures pane: tooltip and VoiceOver help of the pull-down of Up or Down while \"Up and Down follow the hand too\" is on and its action cannot open with the hand on this version of macOS",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs once. It does not follow the hand on this version of macOS."
          }
        }
      }
    },
    "gesture-follow-once-gesture-off": {
      "comment": "Gestures pane: tooltip and VoiceOver help of the pull-down of Up or Down while \"Up and Down follow the hand too\" is on and the trackpad gesture for its action is switched off in System Settings (Trackpad, More Gestures)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs once. Its trackpad gesture is off in System Settings."
          }
        }
      }
    }
  },
  "version": "1.1"
}
