    "scrolling-thumb-wheel-reverse-hint-scroll": {
      "comment": "Scrolling pane, Thumb wheel group: under Reverse direction while the action is Scroll Sideways (at most two lines)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps the two directions: the wheel scrolls sideways the other way."
          }
        }
      }
    },
    "scrolling-thumb-wheel-reverse-hint-zoom": {
      "comment": "Scrolling pane, Thumb wheel group: under Reverse direction while the action is Zoom (at most two lines)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps the two directions: a turn that zoomed in zooms out."
          }
        }
      }
    },
    "scrolling-thumb-wheel-reverse-hint-tabs": {
      "comment": "Scrolling pane, Thumb wheel group: under Reverse direction while the action is Switch Tabs (at most two lines)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps the two directions: a turn to the next tab goes to the previous one."
          }
        }
      }
    },
    "scrolling-thumb-wheel-reverse-hint-desktops": {
      "comment": "Scrolling pane, Thumb wheel group: under Reverse direction while the action is Switch Desktops (at most two lines)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps the two directions: a turn to the desktop on the right goes left."
          }
        }
      }
    },
    "scrolling-thumb-wheel-reverse-hint-back-forward": {
      "comment": "Scrolling pane, Thumb wheel group: under Reverse direction while the action is Back and Forward (at most two lines)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps the two directions: a turn that went back goes forward."
          }
        }
      }
    },
    "scrolling-thumb-wheel-reverse-hint-volume": {
      "comment": "Scrolling pane, Thumb wheel group: under Reverse direction while the action is Volume (at most two lines)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps the two directions: a turn that raised the volume lowers it."
