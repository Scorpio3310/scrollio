      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap With"
          }
        }
      }
    },
    "ring-menu-swap-item": {
      "comment": "Shortcut Ring pane, the Swap With submenu: %1$@ is a place in Title Case (Top Right), %2$@ what it holds (Copy; No Action for an empty place)",
