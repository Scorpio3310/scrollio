      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@)"
          }
        }
      }
    },
    "ring-menu-clear": {
      "comment": "Shortcut Ring pane and an app's Shortcut Ring part: the menu a secondary click on a drop of the drawing opens; empties the place",
