    "button_standard_mouse_alias_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Logitech HID++ button has the same meaning as a standard macOS mouse button. Switch this binding to the system mouse-button event to avoid BLE HID++ ownership issues. For better stability, connect through a Bolt or Unifying receiver when possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Logitech HID++ ボタンは標準の macOS マウスボタンと同じ意味を持ちます。この割り当てをシステムのマウスボタンイベントに切り替えると、BLE HID++ の所有権問題を避けられます。安定性を高めるには、可能な場合は Bolt または Unifying レシーバーで接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Logitech HID++ 버튼은 표준 macOS 마우스 버튼과 같은 의미입니다. 이 바인딩을 시스템 마우스 버튼 이벤트로 전환하면 BLE HID++ 소유권 문제를 피할 수 있습니다. 더 안정적으로 사용하려면 가능한 경우 Bolt 또는 Unifying 수신기로 연결하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่ม HID++ ของ Logitech นี้มีความหมายเดียวกับปุ่มเมาส์มาตรฐานของ macOS สลับการผูกนี้ไปใช้เหตุการณ์ปุ่มเมาส์ของระบบเพื่อหลีกเลี่ยงปัญหาการครองสิทธิ์ BLE HID++ เพื่อความเสถียรที่ดีขึ้น แนะนำให้เชื่อมต่อผ่านตัวรับสัญญาณ Bolt หรือ Unifying หากเป็นไปได้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Logitech HID++ 按键与标准 macOS 鼠标按键含义一致。将此绑定切换为系统鼠标按键事件后,可避开 BLE HID++ 接管问题。如需更稳定的接管体验,建议优先通过 Bolt/Unifying 接收器连接设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Logitech HID++ 按鍵與標準 macOS 滑鼠按鍵含義一致。將此綁定切換為系統滑鼠按鍵事件後,可避開 BLE HID++ 接管問題。如需更穩定的接管體驗,建議優先透過 Bolt/Unifying 接收器連接裝置。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Logitech HID++ 按鍵與標準 macOS 滑鼠按鍵含義一致。將此綁定切換為系統滑鼠按鍵事件後,可避開 BLE HID++ 接管問題。如需更穩定的接管體驗,建議優先透過 Bolt/Unifying 接收器連接裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Logitech HID++ 按鍵與標準 macOS 滑鼠按鍵含義一致。將此綁定切換為系統滑鼠按鍵事件後,可避開 BLE HID++ 接管問題。如需更穩定的接管體驗,建議優先透過 Bolt/Unifying 接收器連接裝置。"
          }
        }
      }
    },
