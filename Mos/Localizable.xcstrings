    "gesture-settings-footnote": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí pro všechna tlačítka s navigací gesty. Podržte tlačítko a pohněte myší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alle Tasten mit Gestennavigation. Taste halten und die Maus bewegen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύει για όλα τα κουμπιά πλοήγησης με χειρονομίες. Κρατήστε το κουμπί και μετακινήστε το ποντίκι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to every Gesture Navigation button. Hold the button and move the mouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à tous les boutons de navigation par gestes. Maintenez le bouton et déplacez la souris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのジェスチャーナビゲーションボタンに適用されます。ボタンを押したままマウスを動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 제스처 내비게이션 버튼에 적용됩니다. 버튼을 누른 채 마우스를 움직이세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется ко всем кнопкам навигации жестами. Удерживайте кнопку и двигайте мышь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กับปุ่มการนำทางด้วยท่าทางทั้งหมด กดปุ่มค้างไว้แล้วเลื่อนเมาส์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm Hareketle Gezinme düğmeleri için geçerlidir. Düğmeyi basılı tutup fareyi hareket ettirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діє для всіх кнопок навігації жестами. Утримуйте кнопку й рухайте мишею."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于所有手势导航按键。按住按键并移动鼠标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於所有手勢導航按鍵。按住按鍵並移動滑鼠。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於所有手勢導航按鍵。按住按鍵並移動滑鼠。"
          }
        },
        "zh-Hant-TW": {
