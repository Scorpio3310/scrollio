    "mouse-wheel-sensitivity-hint": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze SmartShift. Vyšší hodnoty přepínají na volné otáčení dříve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur SmartShift. Höhere Werte wechseln früher in den Freilauf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο SmartShift. Υψηλότερες τιμές αλλάζουν νωρίτερα σε ελεύθερη περιστροφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SmartShift only. Higher values switch to free-spin sooner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SmartShift uniquement. Une valeur élevée passe plus tôt en roue libre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SmartShift のみ。値を大きくするとフリースピンに早く切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SmartShift 전용. 값이 높을수록 더 빨리 프리 스핀으로 전환됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только SmartShift. Чем выше значение, тем раньше включается свободное вращение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะ SmartShift ค่าที่สูงขึ้นจะสลับไปหมุนอิสระเร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca SmartShift. Daha yüksek değerler serbest dönüşe daha erken geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише SmartShift. Що більше значення, то раніше вмикається вільне обертання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限 SmartShift。数值越高，越早切换到自由旋转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限 SmartShift。數值越高，越早切換到自由旋轉。"
