    "scroll-preset-magic-mouse-description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesné kroky, doběh po švihu a odraz na okrajích."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exakte Rasterschritte, Nachlauf nach einem Schwung und Abfedern an den Rändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακριβή βήματα, ολίσθηση μετά από γρήγορη κίνηση και αναπήδηση στα άκρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact notches, a glide after a flick, and a bounce at the edges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crans précis, inertie après un élan et rebond aux extrémités."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ノッチずつ正確に動き、弾くと慣性で流れ、端ではバウンドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 칸씩 정확하게 움직이고, 튕기면 미끄러지며, 끝에서는 튕겨 돌아옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точные шаги, инерция после рывка и отскок у краёв."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนทีละขั้นอย่างแม่นยำ ไหลต่อเมื่อปัดเร็ว และเด้งกลับที่ขอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Net kademeler, hızlı çevirmeden sonra süzülme ve kenarlarda esneme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точні кроки, інерція після ривка та відскік біля країв."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐格精准，快速拨动后滑行，到边缘时回弹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐格精準，快速撥動後滑行，到邊緣時回彈。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "逐格精準，快速撥動後滑行，到邊緣時回彈。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "逐格精準，快速撥動後滑行，到邊緣時回彈。"
          }
        }
      }
    },
