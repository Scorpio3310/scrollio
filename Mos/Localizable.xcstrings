    "button_conflict_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This button appears to be managed by another app. Capturing it in multiple apps at the same time may cause abnormal behavior. Release this button in the other app, or disable that app. For more stable capture, connect the device through a Bolt/Unifying receiver when possible."
          }
        }
      }
    },
    "button_contended_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Button ownership is contested"
          }
        }
      }
    },
    "button_contended_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app keeps clearing Scrollio's HID++ ownership. Over BLE this is commonly caused by Logi Options+, and this control has no safe standard mouse-button alternative. Quit the conflicting app, or connect through a Bolt or Unifying receiver for better stability."
          }
        }
      }
    },
    "button_use_native_mouse": {
      "extractionState": "manual",
      "localizations": {
