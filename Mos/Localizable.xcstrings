    "button_conflict_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Button may be managed by another app"
          }
        }
      }
    },
    "button_conflict_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This button appears to be managed by another app. Capturing it in multiple apps at the same time may cause abnormal behavior. Release this button in the other app, or disable that app. For more stable capture, connect the device through a Bolt/Unifying receiver when possible."
          }
        }
      }
    },
    "button_contended_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Button ownership is contested"
          }
        }
      }
    },
    "button_contended_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app keeps clearing Scrollio's HID++ ownership. Over BLE this is commonly caused by Logi Options+, and this control has no safe standard mouse-button alternative. Quit the conflicting app, or connect through a Bolt or Unifying receiver for better stability."
          }
        }
      }
    },
    "button_use_native_mouse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use system mouse button"
          }
        }
      }
    },
    "button_standard_mouse_alias_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System mouse button available"
          }
        }
      }
    },
    "button_standard_mouse_alias_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Logitech HID++ button has the same meaning as a standard macOS mouse button. Switch this binding to the system mouse-button event to avoid BLE HID++ ownership issues. For better stability, connect through a Bolt or Unifying receiver when possible."
          }
        }
      }
    },
    "button_ble_hidpp_unstable_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This button may be recognized unreliably"
          }
        }
      }
    },
    "button_ble_hidpp_unstable_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Logi button has no standard macOS mouse-button fallback. Over a Bluetooth connection, the data stream may be taken over or interrupted by Logitech Options. For stable triggering, try connecting through a Bolt/Unifying receiver, or try disabling Logitech Options."
          }
        }
      }
    },
    "logi_ble_hidpp_unstable_toast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses BLE HID++ notifications, which may be interrupted by Logi Options+. Bolt/Unifying is usually more reliable."
          }
        }
      }
    },
    "logi_ble_contention_standard_mouse_alias_toast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ BLE HID++ capture is being cleared by another app. Scrollio can switch this binding to the system mouse button. Bolt/Unifying is usually more stable."
          }
        }
      }
    },
    "logi_hidpp_contention_toast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ HID++ capture is being cleared by another app. Release it there, or use Bolt/Unifying for better stability."
          }
        }
      }
    },
