    "mouse-wheel-force-hint": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak pevně kolečko cvaká. MX Master 4 a novější."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie fest das Rad einrastet. MX Master 4 und neuer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσο σταθερά κάνει κλικ η ροδέλα. MX Master 4 και νεότερα."
