    "button_ble_hidpp_unstable_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Logi button has no standard macOS mouse-button fallback. Over a Bluetooth connection, the data stream may be taken over or interrupted by Logitech Options. For stable triggering, try connecting through a Bolt/Unifying receiver, or try disabling Logitech Options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Logi ボタンには標準 macOS マウスボタンへのフォールバックがありません。Bluetooth 接続では、データストリームが Logitech Options に取得または中断される場合があります。安定してトリガーするには、Bolt/Unifying レシーバーで接続するか、Logitech Options の無効化を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Logi 버튼에는 표준 macOS 마우스 버튼 폴백이 없습니다. Bluetooth 연결에서는 데이터 스트림이 Logitech Options에 의해 선점되거나 중단될 수 있습니다. 안정적으로 트리거하려면 Bolt/Unifying 수신기로 연결하거나 Logitech Options를 비활성화해 보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่ม Logi นี้ไม่มีทางเลือกสำรองเป็นปุ่มเมาส์มาตรฐานของ macOS เมื่อเชื่อมต่อผ่านบลูทูธ กระแสข้อมูลอาจถูก Logitech Options แย่งใช้หรือขัดจังหวะ เพื่อให้ทำงานได้เสถียร ลองเชื่อมต่อผ่านตัวรับสัญญาณ Bolt/Unifying หรือลองปิดใช้งาน Logitech Options"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Logi 按键没有标准 macOS 鼠标按键回退, 蓝牙链接下数据流可能被 Logitech Options 抢占或中断. 如需稳定触发, 请尝试通过 Bolt/Unifying 接收器链接, 或尝试停用 Logitech Options."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Logi 按鍵沒有標準 macOS 滑鼠按鍵回退, 藍牙連線下資料流可能被 Logitech Options 搶占或中斷. 如需穩定觸發, 請嘗試透過 Bolt/Unifying 接收器連線, 或嘗試停用 Logitech Options."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Logi 按鍵沒有標準 macOS 滑鼠按鍵回退, 藍牙連線下資料流可能被 Logitech Options 搶佔或中斷. 如需穩定觸發, 請嘗試透過 Bolt/Unifying 接收器連線, 或嘗試停用 Logitech Options."
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Logi 按鍵沒有標準 macOS 滑鼠按鍵回退, 藍牙連線下資料流可能被 Logitech Options 搶佔或中斷. 如需穩定觸發, 請嘗試透過 Bolt/Unifying 接收器連線, 或嘗試停用 Logitech Options."
          }
        }
      }
    },
    "logi_ble_hidpp_unstable_toast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uses BLE HID++ notifications, which may be interrupted by Logi Options+. Bolt/Unifying is usually more reliable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は BLE HID++ 通知を使用するため、Logi Options+ によって中断される場合があります。通常は Bolt/Unifying の方が安定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은 BLE HID++ 알림을 사용하며 Logi Options+에 의해 중단될 수 있습니다. 보통 Bolt/Unifying이 더 안정적입니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ใช้การแจ้งเตือน BLE HID++ ซึ่งอาจถูก Logi Options+ ขัดจังหวะได้ โดยทั่วไป Bolt/Unifying จะเสถียรกว่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 通过 BLE HID++ 通知识别，该通知流可能被 Logi Options+ 抢占或中断。Bolt/Unifying 通常更可靠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 透過 BLE HID++ 通知識別，該通知流可能被 Logi Options+ 搶占或中斷。Bolt/Unifying 通常更可靠。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 透過 BLE HID++ 通知識別，該通知流可能被 Logi Options+ 搶占或中斷。Bolt/Unifying 通常更可靠。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 透過 BLE HID++ 通知識別，該通知流可能被 Logi Options+ 搶占或中斷。Bolt/Unifying 通常更可靠。"
          }
        }
      }
    },
    "logi_ble_contention_standard_mouse_alias_toast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ BLE HID++ capture is being cleared by another app. Mos can switch this binding to the system mouse button. Bolt/Unifying is usually more stable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の BLE HID++ キャプチャが他のアプリに解除されています。Mos はこの割り当てをシステムのマウスボタンに切り替えられます。通常は Bolt/Unifying の方が安定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ BLE HID++ 캡처가 다른 앱에 의해 해제되고 있습니다. Mos는 이 바인딩을 시스템 마우스 버튼으로 전환할 수 있습니다. 보통 Bolt/Unifying이 더 안정적입니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การครองสิทธิ์ BLE HID++ ของ %@ กำลังถูกแอปอื่นล้างอยู่ Mos สามารถสลับการผูกนี้ไปใช้ปุ่มเมาส์ของระบบได้ โดยทั่วไป Bolt/Unifying จะเสถียรกว่า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 BLE HID++ 接管正被其他应用清除。Mos 可将此绑定切换为系统鼠标按键；Bolt/Unifying 通常更稳定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 BLE HID++ 接管正被其他應用程式清除。Mos 可將此綁定切換為系統滑鼠按鍵；Bolt/Unifying 通常更穩定。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 BLE HID++ 接管正被其他應用程式清除。Mos 可將此綁定切換為系統滑鼠按鍵；Bolt/Unifying 通常更穩定。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 BLE HID++ 接管正被其他應用程式清除。Mos 可將此綁定切換為系統滑鼠按鍵；Bolt/Unifying 通常更穩定。"
          }
        }
      }
    },
    "logi_hidpp_contention_toast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ HID++ capture is being cleared by another app. Release it there, or use Bolt/Unifying for better stability."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の HID++ キャプチャが他のアプリに解除されています。そのアプリで解除するか、安定性を高めるには Bolt/Unifying を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ HID++ 캡처가 다른 앱에 의해 해제되고 있습니다. 해당 앱에서 해제하거나, 더 안정적으로 사용하려면 Bolt/Unifying을 사용하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การครองสิทธิ์ HID++ ของ %@ กำลังถูกแอปอื่นล้างอยู่ โปรดปลดสิทธิ์ที่แอปนั้น หรือใช้ Bolt/Unifying เพื่อความเสถียรที่ดีขึ้น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 HID++ 接管正被其他应用清除。请在对应应用中释放该按键，或使用 Bolt/Unifying 提高稳定性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 HID++ 接管正被其他應用程式清除。請在對應應用程式中釋放該按鍵，或使用 Bolt/Unifying 提高穩定性。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 HID++ 接管正被其他應用程式清除。請在對應應用程式中釋放該按鍵，或使用 Bolt/Unifying 提高穩定性。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的 HID++ 接管正被其他應用程式清除。請在對應應用程式中釋放該按鍵，或使用 Bolt/Unifying 提高穩定性。"
          }
        }
      }
    },
