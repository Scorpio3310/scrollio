            "value": "Следовать за рукой"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนตามมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eli takip et"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слідувати за рукою"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随手部移动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨手部移動"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨手部移動"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨手部移動"
          }
        }
      }
    },
    "gesture-mode-interactive-note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledování ruky je experimentální: při podrženém tlačítku se pohybem do stran posouváte mezi plochami spolu s myší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Der Hand folgen“ ist experimentell: Bei gehaltener Taste gleiten die Schreibtische seitlich mit der Maus mit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «Ακολουθεί το χέρι» είναι πειραματικό: με πατημένο το κουμπί, η πλάγια κίνηση σύρει τα γραφεία μαζί με το ποντίκι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the hand is experimental: sideways movement slides between desktops with the mouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Suivre la main » est expérimental : bouton maintenu, un mouvement latéral fait glisser les bureaux avec la souris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「手の動きに追従」は実験的な機能です。ボタンを押したまま横に動かすと、マウスに合わせてデスクトップがスライドします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘손 움직임 따라가기’는 실험적 기능입니다. 버튼을 누른 채 옆으로 움직이면 데스크탑이 마우스를 따라 미끄러집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Следовать за рукой» — экспериментальный режим: при удержании кнопки движение в сторону сдвигает рабочие столы вместе с мышью."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“เลื่อนตามมือ” ยังอยู่ในขั้นทดลอง: เมื่อกดปุ่มค้างไว้ การเลื่อนเมาส์ไปด้านข้างจะเลื่อนเดสก์ท็อปตามเมาส์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Eli takip et” deneyseldir: düğme basılıyken yana doğru hareket, masaüstlerini fareyle birlikte kaydırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Слідувати за рукою» — експериментальний режим: поки кнопку утримують, рух убік зсуває робочі столи разом із мишею."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随手部移动”为实验性功能：按住按键时，左右移动会让桌面随鼠标滑动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟隨手部移動」為實驗性功能：按住按鍵時，左右移動會讓桌面隨滑鼠滑動。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟隨手部移動」為實驗性功能：按住按鍵時，左右移動會讓桌面隨滑鼠滑動。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "「跟隨手部移動」為實驗性功能：按住按鍵時，左右移動會讓桌面隨滑鼠滑動。"
          }
        }
      }
    },
