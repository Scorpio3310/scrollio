            "value": "Suivre la main"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手の動きに追従"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손 움직임 따라가기"
          }
        },
        "ru": {
          "stringUnit": {
