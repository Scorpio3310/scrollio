    "mouse-wheel-managed-hint": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mos tato nastavení zapíše do myši, jakmile se připojí. Nenechte je současně spravovat Logi Options+."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mos überträgt diese Einstellungen auf die Maus, sobald sie sich verbindet. Lassen Sie sie nicht gleichzeitig von Logi Options+ verwalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Mos γράφει αυτές τις ρυθμίσεις στο ποντίκι όταν συνδέεται. Μην τις διαχειρίζεται ταυτόχρονα το Logi Options+."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mos writes these settings to the mouse when it connects. Don't let Logi Options+ manage them at the same time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mos applique ces réglages à la souris lorsqu’elle se connecte. Ne laissez pas Logi Options+ les gérer en même temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの接続時に Mos がこれらの設定をマウスに書き込みます。Logi Options+ で同時に管理しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스가 연결되면 Mos가 이 설정을 마우스에 기록합니다. Logi Options+에서 동시에 관리하지 마세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mos записывает эти настройки в мышь при её подключении. Не управляйте ими одновременно через Logi Options+."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mos จะเขียนการตั้งค่าเหล่านี้ลงในเมาส์เมื่อเชื่อมต่อ อย่าให้ Logi Options+ จัดการในเวลาเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mos bu ayarları fare bağlandığında fareye yazar. Aynı anda Logi Options+ tarafından yönetilmelerine izin vermeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mos записує ці налаштування в мишу під час її під’єднання. Не керуйте ними одночасно через Logi Options+."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼠标连接时，Mos 会将这些设置写入鼠标。请勿同时让 Logi Options+ 管理这些设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠連線時，Mos 會將這些設定寫入滑鼠。請勿同時讓 Logi Options+ 管理這些設定。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠連線時，Mos 會將這些設定寫入滑鼠。請勿同時讓 Logi Options+ 管理這些設定。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "滑鼠連線時，Mos 會將這些設定寫入滑鼠。請勿同時讓 Logi Options+ 管理這些設定。"
          }
        }
      }
    },
