    "scroll-tuning-thumb-wheel-hint": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volba „Přejíždět mezi stránkami“ je v Nastavení systému (Myš nebo Trackpad) vypnutá, takže aplikace toto gesto ignorují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zwischen Seiten streichen“ ist in den Systemeinstellungen (Maus oder Trackpad) aus, daher ignorieren Apps diese Geste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλογή «Σάρωση μεταξύ σελίδων» είναι ανενεργή στις Ρυθμίσεις συστήματος (Ποντίκι ή Trackpad), οπότε οι εφαρμογές αγνοούν αυτή τη χειρονομία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Swipe between pages” is off in System Settings (Mouse or Trackpad), so apps ignore this gesture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Balayer entre les pages » est désactivé dans Réglages Système (Souris ou Trackpad) ; les apps ignorent donc ce geste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定（マウスまたはトラックパッド）の「ページ間をスワイプ」がオフのため、アプリはこのジェスチャーを無視します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정(마우스 또는 트랙패드)에서 ‘페이지 쓸어넘기기’가 꺼져 있어 앱이 이 제스처를 무시합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр «Смахивание между страницами» выключен в Системных настройках (Мышь или Трекпад), поэтому приложения игнорируют этот жест."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ปัดไปมาระหว่างหน้า” ปิดอยู่ในการตั้งค่าระบบ (เมาส์หรือแทร็กแพด) แอปจึงไม่ตอบสนองต่อท่าทางนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları’nda (Fare veya Trackpad) “Sayfalar arasında kaydır” kapalı olduğundan uygulamalar bu hareketi yok sayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр «Перехід між сторінками» вимкнено в Системних параметрах (Миша або Трекпад), тому програми ігнорують цей жест."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置（鼠标或触控板）中的“在页面之间轻扫”已关闭，因此应用会忽略此手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定（滑鼠或觸控式軌跡板）中的「在頁面之間滑動」已關閉，因此應用程式會忽略此手勢。"
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定（滑鼠或觸控式軌跡板）中的「在頁面之間滑動」已關閉，因此應用程式會忽略此手勢。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定（滑鼠或觸控式軌跡板）中的「在頁面之間滑動」已關閉，因此應用程式會忽略此手勢。"
          }
        }
      }
    },
